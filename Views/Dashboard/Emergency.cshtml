@model EmergencySearchModel

@{
    ViewData["Title"] = "Emergency Numbers";
    var emergencyData = ViewBag.EmergencyNumbers as EmergencyNumbersModel;
}

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h2>🚨 Emergency Numbers</h2>
    </div>

    <!-- Search Card -->
    <div class="card mb-4">
        <div class="card-header" style="background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%); color: white;">
            <h4 style="margin: 0; color: white;">Search Emergency Numbers by Country</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-8">
                        <input type="text" name="Country" class="form-control" 
                               placeholder="Enter country name (e.g., India, USA, UK)" 
                               value="@Model.Country" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-danger w-100">
                            🔍 Search
                        </button>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <strong>Error!</strong> @ViewBag.Error
                </div>
            }
        </div>
    </div>

    @if (emergencyData != null && emergencyData.Country != null)
    {
        <!-- Country Info -->
        <div class="card mb-4">
            <div class="card-body text-center">
                <h3 class="mb-2">@emergencyData.Country.Name</h3>
                <p class="text-muted mb-0">
                    ISO Code: @emergencyData.Country.ISOCode | 
                    ISO Numeric: @emergencyData.Country.ISONumeric
                </p>
            </div>
        </div>

        var hasAnyNumbers = (emergencyData.Police?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true) ||
                           (emergencyData.Ambulance?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true) ||
                           (emergencyData.Fire?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true) ||
                           (emergencyData.Dispatch?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true) ||
                           emergencyData.Member_112 ||
                           (emergencyData.Traffic?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true);

        if (hasAnyNumbers)
        {
            <!-- Emergency Numbers Grid -->
            <div class="row g-4 mb-4">
                <!-- Police -->
                @if (emergencyData.Police?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card police-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">👮</div>
                                <h5 class="card-title">Police</h5>
                                <div class="emergency-numbers">
                                    @foreach (var number in emergencyData.Police.All.Where(n => !string.IsNullOrWhiteSpace(n)))
                                    {
                                        <a href="tel:@number" class="emergency-number">@number</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Ambulance -->
                @if (emergencyData.Ambulance?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card ambulance-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">🚑</div>
                                <h5 class="card-title">Ambulance</h5>
                                <div class="emergency-numbers">
                                    @foreach (var number in emergencyData.Ambulance.All.Where(n => !string.IsNullOrWhiteSpace(n)))
                                    {
                                        <a href="tel:@number" class="emergency-number">@number</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Fire -->
                @if (emergencyData.Fire?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card fire-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">🚒</div>
                                <h5 class="card-title">Fire Department</h5>
                                <div class="emergency-numbers">
                                    @foreach (var number in emergencyData.Fire.All.Where(n => !string.IsNullOrWhiteSpace(n)))
                                    {
                                        <a href="tel:@number" class="emergency-number">@number</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Dispatch -->
                @if (emergencyData.Dispatch?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card dispatch-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">📞</div>
                                <h5 class="card-title">Emergency Dispatch</h5>
                                <div class="emergency-numbers">
                                    @foreach (var number in emergencyData.Dispatch.All.Where(n => !string.IsNullOrWhiteSpace(n)))
                                    {
                                        <a href="tel:@number" class="emergency-number">@number</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Member 112 -->
                @if (emergencyData.Member_112)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card member-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">🆘</div>
                                <h5 class="card-title">Emergency (112)</h5>
                                <div class="emergency-numbers">
                                    <a href="tel:112" class="emergency-number">112</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Traffic -->
                @if (emergencyData.Traffic?.All?.Any(n => !string.IsNullOrWhiteSpace(n)) == true)
                {
                    <div class="col-md-4">
                        <div class="card emergency-card traffic-card">
                            <div class="card-body text-center">
                                <div class="emergency-icon">🚦</div>
                                <h5 class="card-title">Traffic Police</h5>
                                <div class="emergency-numbers">
                                    @foreach (var number in emergencyData.Traffic.All.Where(n => !string.IsNullOrWhiteSpace(n)))
                                    {
                                        <a href="tel:@number" class="emergency-number">@number</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Important Note -->
            <div class="alert alert-warning" role="alert">
                <strong>⚠️ Important:</strong> These numbers are for emergency use only. 
                Please use them responsibly and only in case of genuine emergencies.
            </div>
        }
        else
        {
            <!-- No Numbers Available Message -->
            <div class="card mb-4">
                <div class="card-body text-center py-5">
                    <div class="empty-icon">📵</div>
                    <h4 class="mb-3">No Emergency Numbers Available</h4>
                    <p class="text-muted mb-0">
                        Unfortunately, emergency numbers for <strong>@emergencyData.Country.Name</strong> are not available in our database.
                        Please try searching for another country or contact local authorities for emergency contact information.
                    </p>
                </div>
            </div>
        }
    }

    <!-- Back Button -->
    <div class="text-center mb-4">
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-back">
            ← Back to Dashboard
        </a>
    </div>
</div>

<style>
    .emergency-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        min-height: 220px;
    }

    .emergency-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .police-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .ambulance-card {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .fire-card {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        color: white;
    }

    .dispatch-card {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .member-card {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .traffic-card {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
        color: white;
    }

    .emergency-icon {
        font-size: 4rem;
        margin-bottom: 15px;
    }

    .card-title {
        font-weight: 700;
        font-size: 1.3rem;
        margin-bottom: 15px;
        color: white !important;
    }

    .emergency-numbers {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .emergency-number {
        display: inline-block;
        background: rgba(255, 255, 255, 0.2);
        color: white !important;
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 1.5rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .emergency-number:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: scale(1.05);
    }

    .dashboard-header {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 15px 20px;
        margin-bottom: 15px;
        box-shadow: 0 2px 10px var(--shadow-light);
        border: 1px solid var(--border-color);
    }

    .dashboard-header h2 {
        margin: 0;
        color: var(--text-primary);
        font-weight: 700;
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    @@media (max-width: 768px) {
        .emergency-card {
            min-height: 180px;
        }

        .emergency-icon {
            font-size: 3rem;
        }

        .emergency-number {
            font-size: 1.2rem;
            padding: 10px 15px;
        }
    }
</style>
