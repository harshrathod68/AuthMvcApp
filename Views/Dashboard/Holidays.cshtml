@model HolidaySearchModel

@{
    ViewData["Title"] = "Public Holidays";
    var holidays = ViewBag.Holidays as List<PublicHoliday>;
    var totalHolidays = ViewBag.TotalHolidays as int?;
}

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h2>🎉 Public Holidays</h2>
    </div>

    <!-- Search Card -->
    <div class="card mb-4">
        <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h4 style="margin: 0; color: white;">Search Holidays by Country & Year</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-3">
                <strong>ℹ️ Supported Countries:</strong> India, USA, UK, Canada, Australia, Germany, France, Japan, China, Brazil, Mexico, and 230+ more countries worldwide!
                <br><strong>📅 Year Range:</strong> 2020-2049 (Historical + Future holidays)
            </div>
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Country</label>
                        <input type="text" name="Country" class="form-control" 
                               placeholder="e.g., India, USA, UK, Canada, Germany, Japan" 
                               value="@Model.Country" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Year</label>
                        <select name="Year" class="form-select" required>
                            @for (int year = 2020; year <= 2049; year++)
                            {
                                <option value="@year" selected="@(year == Model.Year)">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">
                            🔍 Search Holidays
                        </button>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <strong>Error!</strong> @ViewBag.Error
                </div>
            }
        </div>
    </div>

    @if (holidays != null && holidays.Any())
    {
        <!-- Summary Card -->
        <div class="card mb-4 summary-card">
            <div class="card-body text-center">
                <h3 class="mb-2">@Model.Country - @Model.Year</h3>
                <div class="holiday-count">
                    <span class="count-number">@totalHolidays</span>
                    <span class="count-label">Public Holidays</span>
                </div>
            </div>
        </div>

        <!-- Holidays Timeline -->
        <div class="holidays-timeline">
            @{
                var monthGroups = holidays.GroupBy(h => DateTime.Parse(h.Date).ToString("MMMM yyyy"));
            }

            @foreach (var monthGroup in monthGroups)
            {
                <div class="month-section">
                    <h4 class="month-header">📅 @monthGroup.Key</h4>
                    <div class="row g-3">
                        @foreach (var holiday in monthGroup)
                        {
                            var date = DateTime.Parse(holiday.Date);
                            var dayOfWeek = date.ToString("dddd");
                            var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                            
                            <div class="col-md-6">
                                <div class="holiday-card @(isWeekend ? "weekend" : "")">
                                    <div class="holiday-date">
                                        <div class="date-day">@date.Day</div>
                                        <div class="date-month">@date.ToString("MMM")</div>
                                    </div>
                                    <div class="holiday-info">
                                        <h5 class="holiday-name">@holiday.Name</h5>
                                        @if (!string.IsNullOrEmpty(holiday.LocalName) && holiday.LocalName != holiday.Name)
                                        {
                                            <p class="holiday-local">@holiday.LocalName</p>
                                        }
                                        <div class="holiday-meta">
                                            <span class="badge bg-info">@dayOfWeek</span>
                                            @if (holiday.Types != null && holiday.Types.Any())
                                            {
                                                @foreach (var type in holiday.Types)
                                                {
                                                    <span class="badge bg-secondary">@type</span>
                                                }
                                            }
                                            @if (holiday.Global)
                                            {
                                                <span class="badge bg-success">National</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Back Button -->
    <div class="text-center mt-4 mb-4">
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-back">
            ← Back to Dashboard
        </a>
    </div>
</div>

<style>
    .summary-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .holiday-count {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

    .count-number {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
    }

    .count-label {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 5px;
    }

    .holidays-timeline {
        margin-top: 20px;
    }

    .month-section {
        margin-bottom: 30px;
    }

    .month-header {
        color: var(--text-primary);
        font-weight: 700;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--border-color);
    }

    .holiday-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 15px;
        display: flex;
        gap: 15px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px var(--shadow-light);
    }

    .holiday-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px var(--shadow-medium);
        border-color: #667eea;
    }

    .holiday-card.weekend {
        background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
        border-color: #fdcb6e;
    }

    .holiday-date {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
        min-width: 70px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .holiday-card.weekend .holiday-date {
        background: linear-gradient(135deg, #e17055 0%, #d63031 100%);
    }

    .date-day {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .date-month {
        font-size: 0.9rem;
        text-transform: uppercase;
        opacity: 0.9;
        margin-top: 5px;
    }

    .holiday-info {
        flex: 1;
    }

    .holiday-name {
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 5px;
    }

    .holiday-card.weekend .holiday-name {
        color: #2d3436;
    }

    .holiday-local {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .holiday-card.weekend .holiday-local {
        color: #636e72;
    }

    .holiday-meta {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .holiday-meta .badge {
        font-size: 0.75rem;
        padding: 4px 8px;
    }

    .dashboard-header {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 15px 20px;
        margin-bottom: 15px;
        box-shadow: 0 2px 10px var(--shadow-light);
        border: 1px solid var(--border-color);
    }

    .dashboard-header h2 {
        margin: 0;
        color: var(--text-primary);
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .count-number {
            font-size: 3rem;
        }

        .holiday-card {
            flex-direction: column;
            text-align: center;
        }

        .holiday-date {
            margin: 0 auto;
        }
    }
</style>
