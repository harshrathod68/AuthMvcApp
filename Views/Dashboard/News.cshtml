@model MyApps.Models.NewsSearchModel
@{
    ViewData["Title"] = "Latest News";
    var articles = ViewBag.Articles as List<MyApps.Models.NewsArticle> ?? new List<MyApps.Models.NewsArticle>();
}

<div class="news-container">
    <!-- Filter Section -->
    <div class="card filter-card mb-4">
        <div class="card-body p-4">
            <div class="text-center mb-3">
                <span class="filter-icon">📰</span>
                <h4 class="fw-bold mt-2">Latest News</h4>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning text-center">@ViewBag.Error</div>
            }

            <form asp-action="News" method="post">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Language</label>
                        <select asp-for="Language" class="form-select uniform-input">
                            <option value="en">🇬🇧 English</option>
                            <option value="hi">🇮🇳 Hindi</option>
                            <option value="ar">🇸🇦 Arabic</option>
                            <option value="zh">🇨🇳 Chinese</option>
                            <option value="fr">🇫🇷 French</option>
                            <option value="de">🇩🇪 German</option>
                            <option value="ja">🇯🇵 Japanese</option>
                            <option value="es">🇪🇸 Spanish</option>
                            <option value="pt">🇵🇹 Portuguese</option>
                            <option value="ru">🇷🇺 Russian</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Search Country</label>
                        <input asp-for="Country" class="form-control uniform-input" placeholder="e.g., India, USA" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Category</label>
                        <select asp-for="Category" class="form-select uniform-input">
                            <option value="">All Categories</option>
                            <option value="general">📰 General</option>
                            <option value="world">🌍 World</option>
                            <option value="nation">🏛️ Nation</option>
                            <option value="business">💼 Business</option>
                            <option value="technology">💻 Technology</option>
                            <option value="sports">⚽ Sports</option>
                            <option value="entertainment">🎬 Entertainment</option>
                            <option value="health">🏥 Health</option>
                            <option value="science">🔬 Science</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Search News</label>
                        <input asp-for="SearchQuery" class="form-control uniform-input" placeholder="Search keywords..." />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary uniform-input w-100">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- News Grid -->
    @if (articles.Any())
    {
        <div class="row g-4">
            @foreach (var article in articles)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card news-card h-100">
                        <div class="news-image-container">
                            @if (!string.IsNullOrEmpty(article.ImageUrl))
                            {
                                <img src="@article.ImageUrl" class="news-image" alt="@article.Title" 
                                     onerror="this.src='https://via.placeholder.com/400x200?text=No+Image'" />
                            }
                            else
                            {
                                <div class="news-placeholder">📰</div>
                            }
                            <span class="news-source">@article.SourceName</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="news-title">@article.Title</h6>
                            <p class="news-desc">
                                @(article.Description?.Length > 120 ? article.Description.Substring(0, 120) + "..." : article.Description)
                            </p>
                            <div class="mt-auto">
                                <div class="news-meta">
                                    <span><i class="bi bi-person me-1"></i>@article.Author</span>
                                    <span><i class="bi bi-clock me-1"></i>@(article.PublishedAt?.ToString("MMM dd, HH:mm") ?? "N/A")</span>
                                </div>
                                <a href="@article.Url" target="_blank" class="btn btn-outline-primary btn-sm w-100 mt-2">
                                    Read Full Article <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Load More Button -->
        @if (ViewBag.HasMore == true)
        {
            <div class="text-center mt-4">
                <form asp-action="News" method="post" class="d-inline">
                    <input type="hidden" asp-for="Language" />
                    <input type="hidden" asp-for="Country" />
                    <input type="hidden" asp-for="Category" />
                    <input type="hidden" asp-for="SearchQuery" />
                    <input type="hidden" name="Page" value="@(Model.Page + 1)" />
                    <button type="submit" class="btn btn-load-more">
                        <i class="bi bi-arrow-down-circle me-2"></i>Load More News
                    </button>
                </form>
            </div>
        }

        <!-- Page Info -->
        <div class="text-center mt-3">
            <span class="text-muted">Page @Model.Page</span>
        </div>
    }
    else if (ViewBag.Error == null)
    {
        <div class="text-center py-5">
            <span style="font-size: 4rem;">📭</span>
            <h5 class="mt-3 text-muted">Select filters and click Search to load news</h5>
        </div>
    }
</div>

<!-- Back Button at Bottom -->
<div class="text-center mt-4 mb-4">
    <a asp-action="Index" class="btn btn-back">
        <i class="bi bi-arrow-left me-2"></i>← Back to Dashboard
    </a>
</div>

<style>
    .news-container { padding: 20px 0; }
    
    .filter-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }
    
    [data-theme="dark"] .filter-card {
        background: #2d2d2d;
        color: #ffffff;
    }
    
    .filter-icon { font-size: 2.5rem; }
    
    .news-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        overflow: hidden;
    }
    
    [data-theme="dark"] .news-card {
        background: #2d2d2d;
        color: #ffffff;
    }
    
    .news-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }
    
    .news-image-container {
        position: relative;
        height: 180px;
        overflow: hidden;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .news-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .news-placeholder {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: white;
    }
    
    .news-source {
        position: absolute;
        bottom: 10px;
        left: 10px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .news-title {
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.4;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: inherit;
    }
    
    .news-desc {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.5;
    }
    
    [data-theme="dark"] .news-desc {
        color: #cccccc;
    }
    
    .news-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: #888;
    }
    
    [data-theme="dark"] .news-meta {
        color: #aaaaaa;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 10px;
    }
    
    .form-select, .form-control {
        border-radius: 10px;
        border: 2px solid #e0e0e0;
    }
    
    .form-select:focus, .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
    }
    
    /* Uniform input sizes */
    .uniform-input {
        height: 42px !important;
        font-size: 0.9rem;
        padding: 8px 12px;
    }
    
    .uniform-input.btn {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    .btn-load-more {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        border: none;
        border-radius: 25px;
        padding: 12px 40px;
        font-weight: 600;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .btn-load-more:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(250, 112, 154, 0.4);
        color: white;
    }
</style>
