@model MyApps.Models.CurrencyConversionModel
@using MyApps.Models
@{
    ViewData["Title"] = "Currency Conversion";
    var result = ViewBag.Result as CurrencyResultModel;
    var currencies = SupportedCurrencies.Currencies;
}

<div class="currency-container">
    <!-- Header Section -->
    <div class="currency-header text-center">
        <h2>💱 Currency Converter</h2>
        <p class="text-muted">Real-time exchange rates for 20+ currencies</p>
    </div>

    <!-- Conversion Card -->
    <div class="card conversion-card">
        <div class="card-body">
            <form asp-action="Currency" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <span>⚠️</span> @ViewBag.Error
                    </div>
                }

                <!-- Amount Input -->
                <div class="mb-4">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <div class="input-group amount-input">
                        <span class="input-group-text">💰</span>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="Enter amount" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <!-- Currency Selection Row -->
                <div class="row g-3 align-items-end">
                    <!-- From Currency -->
                    <div class="col-md-5">
                        <label asp-for="FromCurrency" class="form-label">From</label>
                        <select asp-for="FromCurrency" class="form-select currency-select">
                            @foreach (var currency in currencies)
                            {
                                <option value="@currency.Key">
                                    @currency.Value.Flag @currency.Key - @currency.Value.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Swap Button -->
                    <div class="col-md-2 text-center">
                        <button type="button" class="btn btn-swap" onclick="swapCurrencies()">
                            🔄
                        </button>
                    </div>

                    <!-- To Currency -->
                    <div class="col-md-5">
                        <label asp-for="ToCurrency" class="form-label">To</label>
                        <select asp-for="ToCurrency" class="form-select currency-select">
                            @foreach (var currency in currencies)
                            {
                                <option value="@currency.Key">
                                    @currency.Value.Flag @currency.Key - @currency.Value.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Convert Button -->
                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-convert">
                        Convert Currency
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Result Card -->
    @if (result != null)
    {
        var fromInfo = currencies.GetValueOrDefault(result.FromCurrency);
        var toInfo = currencies.GetValueOrDefault(result.ToCurrency);
        
        <div class="card result-card mt-4">
            <div class="card-body">
                <div class="result-header text-center">
                    <span class="result-label">Conversion Result</span>
                </div>
                
                <div class="result-main">
                    <div class="result-from">
                        <span class="result-flag">@(fromInfo?.Flag ?? "💵")</span>
                        <span class="result-amount">@result.OriginalAmount.ToString("N2")</span>
                        <span class="result-code">@result.FromCurrency</span>
                    </div>
                    
                    <div class="result-arrow">→</div>
                    
                    <div class="result-to">
                        <span class="result-flag">@(toInfo?.Flag ?? "💵")</span>
                        <span class="result-amount converted">@result.ConvertedAmount.ToString("N2")</span>
                        <span class="result-code">@result.ToCurrency</span>
                    </div>
                </div>

                <div class="result-details">
                    <div class="detail-row">
                        <span class="detail-label">Exchange Rate:</span>
                        <span class="detail-value">1 @result.FromCurrency = @result.ExchangeRate @result.ToCurrency</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Last Updated:</span>
                        <span class="detail-value">@result.LastUpdated.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Popular Conversions -->
    <div class="popular-section mt-4">
        <h6 class="text-center text-muted mb-3">Popular Currency Pairs</h6>
        <div class="row g-2">
            <div class="col-6 col-md-3">
                <button type="button" class="btn btn-popular" onclick="setConversion('USD', 'INR')">
                    🇺🇸 USD → 🇮🇳 INR
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="btn btn-popular" onclick="setConversion('EUR', 'USD')">
                    🇪🇺 EUR → 🇺🇸 USD
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="btn btn-popular" onclick="setConversion('GBP', 'INR')">
                    🇬🇧 GBP → 🇮🇳 INR
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="btn btn-popular" onclick="setConversion('USD', 'EUR')">
                    🇺🇸 USD → 🇪🇺 EUR
                </button>
            </div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">← Back to Dashboard</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Function to swap From and To currencies
        function swapCurrencies() {
            var fromSelect = document.getElementById('FromCurrency');
            var toSelect = document.getElementById('ToCurrency');
            
            var temp = fromSelect.value;
            fromSelect.value = toSelect.value;
            toSelect.value = temp;
        }

        // Function to set popular conversion pairs
        function setConversion(from, to) {
            document.getElementById('FromCurrency').value = from;
            document.getElementById('ToCurrency').value = to;
            document.getElementById('Amount').focus();
        }
    </script>
}

<style>
    .currency-container {
        max-width: 700px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .currency-header {
        margin-bottom: 30px;
    }

    .currency-header h2 {
        font-weight: 700;
        color: #333;
    }

    .conversion-card {
        border: none;
        border-radius: 25px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .conversion-card .card-body {
        padding: 40px;
    }

    .amount-input {
        border-radius: 15px;
        overflow: hidden;
    }

    .amount-input .input-group-text {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        border: none;
        color: white;
        font-size: 1.3rem;
        padding: 15px 20px;
    }

    .amount-input .form-control {
        border: 2px solid #e8e8e8;
        border-left: none;
        padding: 18px 20px;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .currency-select {
        padding: 15px 20px;
        font-size: 1rem;
        border-radius: 15px;
        border: 2px solid #e8e8e8;
        cursor: pointer;
    }

    .currency-select:focus {
        border-color: #11998e;
        box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.15);
    }

    .btn-swap {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        font-size: 1.3rem;
        color: white;
        transition: all 0.3s ease;
        margin-bottom: 5px;
    }

    .btn-swap:hover {
        transform: rotate(180deg);
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
    }

    .btn-convert {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        border: none;
        padding: 18px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 15px;
        color: white;
    }

    .btn-convert:hover {
        background: linear-gradient(135deg, #0f8a80 0%, #32d970 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(17, 153, 142, 0.3);
    }

    /* Result Card Styles */
    .result-card {
        border: none;
        border-radius: 25px;
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
    }

    [data-theme="dark"] .result-card {
        background: linear-gradient(135deg, #1a4a45 0%, #2a5a4a 100%);
        color: #ffffff;
    }

    .result-card .card-body {
        padding: 35px;
    }

    .result-header {
        margin-bottom: 25px;
    }

    .result-label {
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 20px;
        border-radius: 20px;
        font-size: 0.9rem;
    }

    .result-main {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .result-from, .result-to {
        text-align: center;
    }

    .result-flag {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 10px;
    }

    .result-amount {
        font-size: 2rem;
        font-weight: 700;
        display: block;
    }

    .result-amount.converted {
        font-size: 2.5rem;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    }

    .result-code {
        font-size: 1rem;
        opacity: 0.9;
    }

    .result-arrow {
        font-size: 2rem;
        opacity: 0.7;
    }

    .result-details {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 15px;
        padding: 20px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
    }

    .detail-row:not(:last-child) {
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .detail-label {
        opacity: 0.8;
    }

    .detail-value {
        font-weight: 600;
    }

    /* Popular Section */
    .btn-popular {
        width: 100%;
        background: white;
        border: 2px solid #e8e8e8;
        border-radius: 12px;
        padding: 12px 10px;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .btn-popular:hover {
        border-color: #11998e;
        background: rgba(17, 153, 142, 0.05);
        transform: translateY(-2px);
    }

    /* Responsive Styles */
    @@media (max-width: 767px) {
        .currency-container {
            padding: 0 15px;
        }

        .conversion-card .card-body {
            padding: 25px 20px;
        }

        .amount-input .form-control {
            font-size: 1rem;
            padding: 15px;
        }

        .btn-swap {
            width: 45px;
            height: 45px;
            font-size: 1.1rem;
        }

        .result-main {
            flex-direction: column;
            gap: 15px;
        }

        .result-arrow {
            transform: rotate(90deg);
        }

        .result-amount {
            font-size: 1.5rem;
        }

        .result-amount.converted {
            font-size: 2rem;
        }

        .result-flag {
            font-size: 2rem;
        }

        .detail-row {
            flex-direction: column;
            text-align: center;
            gap: 5px;
        }
    }
</style>
