@model List<TimeTrackEntry>
@{
    ViewData["Title"] = "Time Track List";
}

<div class="dashboard-container">
    <!-- Modern Header with Gradient -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-left">
                <div class="header-icon">⏱️</div>
                <div>
                    <h2>Time Track List</h2>
                    <p class="header-subtitle">Track your work time efficiently</p>
                </div>
            </div>
            <div class="header-stats">
                @if (!string.IsNullOrEmpty(ViewBag.SearchDate))
                {
                    <div class="stat-badge">
                        <span class="stat-number">@Model.Count</span>
                        <span class="stat-label">Entries Found</span>
                    </div>
                }
                else
                {
                    <div class="stat-badge stat-badge-info">
                        <span class="stat-icon">🔍</span>
                        <span class="stat-label">Search to View</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show modern-alert">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show modern-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Modern Add Entry Form -->
    <div class="card modern-card mb-4">
        <div class="card-header modern-card-header">
            <div class="header-icon-small">➕</div>
            <h5>Add New Entry</h5>
        </div>
        <div class="card-body">
            <form asp-action="AddTimeTrack" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">
                            <i class="bi bi-briefcase"></i> Work Name
                        </label>
                        <input type="text" name="workName" class="form-control modern-input" placeholder="e.g., Meeting, Coding" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">
                            <i class="bi bi-calendar"></i> Date
                        </label>
                        <input type="date" name="date" class="form-control modern-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">
                            <i class="bi bi-clock"></i> Start Time
                        </label>
                        <input type="time" name="startTime" class="form-control modern-input" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">
                            <i class="bi bi-clock-fill"></i> End Time
                        </label>
                        <input type="time" name="endTime" class="form-control modern-input" required />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-add w-100">
                            <i class="bi bi-plus-circle"></i> Add Entry
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Search by Date Card -->
    <div class="card modern-card mb-4">
        <div class="card-header modern-card-header">
            <div class="header-icon-small">🔍</div>
            <h5>Search by Date</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="TimeTrack">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-calendar-event"></i> Select Date
                        </label>
                        <input type="date" name="searchDate" class="form-control modern-input" 
                               value="@ViewBag.SearchDate" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-search w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    <div class="col-md-3">
                        <a href="@Url.Action("TimeTrack", "Dashboard")" class="btn btn-clear w-100">
                            <i class="bi bi-x-circle"></i> Clear Filter
                        </a>
                    </div>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchDate))
                    {
                        <div class="col-md-2">
                            <div class="search-result-badge">
                                Found: <strong>@Model.Count</strong>
                            </div>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Modern Entries List -->
    <div class="card modern-card">
        <div class="card-header modern-card-header">
            <div class="header-icon-small">📋</div>
            <h5>All Entries (@Model.Count)</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table modern-table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-calendar3"></i> Date</th>
                                <th><i class="bi bi-briefcase-fill"></i> Work Name</th>
                                <th><i class="bi bi-clock"></i> Start</th>
                                <th><i class="bi bi-clock-fill"></i> End</th>
                                <th><i class="bi bi-hourglass-split"></i> Duration</th>
                                <th><i class="bi bi-gear"></i> Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model)
                            {
                                <tr class="table-row-hover">
                                    <td>
                                        <span class="date-badge">
                                            @entry.Date.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <strong class="work-name">@entry.WorkName</strong>
                                    </td>
                                    <td>
                                        <span class="time-badge time-start">
                                            <i class="bi bi-play-fill"></i> @entry.StartTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="time-badge time-end">
                                            <i class="bi bi-stop-fill"></i> @entry.EndTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="duration-badge">
                                            <i class="bi bi-hourglass-split"></i>
                                            @entry.TotalTime.Hours h @entry.TotalTime.Minutes m
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-action="DeleteTimeTrack" method="post" style="display:inline;" onsubmit="return confirm('Delete this entry?');">
                                            <input type="hidden" name="id" value="@entry.Id" />
                                            <button type="submit" class="btn btn-delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    @if (string.IsNullOrEmpty(ViewBag.SearchDate))
                    {
                        <div class="empty-icon">🔍</div>
                        <h4>Search to View Entries</h4>
                        <p>Please select a date above and click "Search" to view your time track entries.</p>
                    }
                    else
                    {
                        <div class="empty-icon">📭</div>
                        <h4>No Entries Found</h4>
                        <p>No time track entries found for <strong>@DateTime.Parse(ViewBag.SearchDate).ToString("dd MMM yyyy")</strong>.</p>
                        <p class="text-muted">Try searching for a different date or add a new entry above.</p>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="text-center mt-4 mb-4">
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-back-modern">
            <i class="bi bi-arrow-left-circle"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
    /* Dashboard Header with Gradient */
    .dashboard-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
        color: white;
    }

    [data-theme="dark"] .dashboard-header {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.2);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        font-size: 3rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
    }

    .dashboard-header h2 {
        margin: 0;
        color: white !important;
        font-weight: 700;
        font-size: 2rem;
    }

    .header-subtitle {
        margin: 5px 0 0 0;
        color: rgba(255, 255, 255, 0.9) !important;
        font-size: 1rem;
    }

    .header-stats {
        display: flex;
        gap: 15px;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 15px 25px;
        border-radius: 15px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .stat-badge-info {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        padding: 12px 20px;
        border-radius: 15px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stat-icon {
        font-size: 1.5rem;
    }

    .stat-number {
        display: block;
        font-size: 2rem;
        font-weight: 700;
        color: white;
    }

    .stat-label {
        display: block;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.9);
        margin-top: 5px;
    }

    /* Modern Alert */
    .modern-alert {
        border-radius: 15px;
        border: none;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .modern-alert i {
        font-size: 1.2rem;
    }

    /* Modern Card */
    .modern-card {
        background-color: var(--card-bg) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 20px;
        box-shadow: 0 5px 25px var(--shadow-light);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .modern-card:hover {
        box-shadow: 0 8px 35px var(--shadow-medium);
        transform: translateY(-2px);
    }

    .modern-card-header {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-bottom: 2px solid var(--border-color) !important;
        padding: 20px 25px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    [data-theme="dark"] .modern-card-header {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
    }

    .header-icon-small {
        font-size: 1.5rem;
    }

    .modern-card-header h5 {
        color: var(--text-primary) !important;
        margin: 0;
        font-weight: 700;
        font-size: 1.3rem;
    }

    .modern-card .card-body {
        background-color: var(--card-bg) !important;
        padding: 25px;
    }

    /* Modern Form Inputs */
    .form-label {
        color: var(--text-primary) !important;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-label i {
        color: #667eea;
        font-size: 1rem;
    }

    .modern-input {
        background-color: var(--input-bg) !important;
        border: 2px solid var(--input-border) !important;
        color: var(--text-primary) !important;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .modern-input:focus {
        background-color: var(--input-bg) !important;
        border-color: #667eea !important;
        color: var(--text-primary) !important;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }

    .modern-input::placeholder {
        color: var(--text-muted) !important;
    }

    /* Modern Buttons */
    .btn-add {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-add:hover {
        background: linear-gradient(135deg, #0f8a80 0%, #32d970 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(17, 153, 142, 0.4);
        color: white;
    }

    .btn-search {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-search:hover {
        background: linear-gradient(135deg, #459ae5 0%, #00d9e5 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.4);
        color: white;
    }

    .btn-clear {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-clear:hover {
        background: linear-gradient(135deg, #e09f15 0%, #d9220f 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(245, 175, 25, 0.4);
        color: white;
        text-decoration: none;
    }

    .search-result-badge {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        border: 2px solid #667eea;
        color: var(--text-primary) !important;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
    }

    .search-result-badge strong {
        color: #667eea !important;
        font-size: 1.2rem;
    }

    .btn-delete {
        background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .btn-delete:hover {
        background: linear-gradient(135deg, #e63a61 0%, #e64327 100%);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(255, 65, 108, 0.4);
        color: white;
    }

    .btn-back-modern {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-back-modern:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        color: white;
        text-decoration: none;
    }

    /* Modern Table */
    .modern-table {
        margin-bottom: 0;
        color: var(--text-primary) !important;
        background-color: var(--card-bg) !important;
        border-radius: 15px;
        overflow: hidden;
    }

    .modern-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        color: white !important;
    }

    .modern-table thead th {
        border: none !important;
        font-weight: 600 !important;
        color: white !important;
        background: transparent !important;
        padding: 18px 15px;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .modern-table thead th i {
        margin-right: 5px;
        opacity: 0.9;
    }

    .modern-table tbody {
        background-color: var(--card-bg) !important;
    }

    .table-row-hover {
        transition: all 0.3s ease;
        border-bottom: 1px solid var(--border-color) !important;
        background-color: var(--card-bg) !important;
    }

    .table-row-hover:hover {
        background-color: rgba(102, 126, 234, 0.08) !important;
        transform: scale(1.01);
        box-shadow: 0 3px 15px var(--shadow-light);
    }

    .modern-table tbody td {
        color: var(--text-primary) !important;
        border-color: var(--border-color) !important;
        vertical-align: middle;
        background-color: transparent !important;
        padding: 16px 15px;
    }

    .work-name {
        color: var(--text-primary) !important;
        font-weight: 600 !important;
        font-size: 1.05rem;
    }

    /* Modern Badges */
    .date-badge {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-block;
        box-shadow: 0 3px 10px rgba(79, 172, 254, 0.3);
    }

    .time-badge {
        padding: 6px 14px;
        border-radius: 15px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .time-start {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        box-shadow: 0 3px 10px rgba(17, 153, 142, 0.3);
    }

    .time-end {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
        color: white;
        box-shadow: 0 3px 10px rgba(245, 175, 25, 0.3);
    }

    .duration-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 3px 10px rgba(102, 126, 234, 0.3);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 20px;
        opacity: 0.5;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .empty-state h4 {
        color: var(--text-primary) !important;
        font-weight: 700;
        margin-bottom: 10px;
        font-size: 1.5rem;
    }

    .empty-state p {
        color: var(--text-muted) !important;
        font-size: 1rem;
    }

    /* Table Responsive */
    .table-responsive {
        background-color: var(--card-bg) !important;
        border-radius: 15px;
    }

    /* Alert Styles */
    .alert {
        background-color: var(--bg-secondary) !important;
        border-color: var(--border-color) !important;
        color: var(--text-primary) !important;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%) !important;
        border-left: 4px solid #11998e !important;
        color: var(--text-primary) !important;
    }

    .alert-danger {
        background: linear-gradient(135deg, rgba(255, 65, 108, 0.15) 0%, rgba(255, 75, 43, 0.15) 100%) !important;
        border-left: 4px solid #ff416c !important;
        color: var(--text-primary) !important;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 20px;
        }

        .header-content {
            flex-direction: column;
            text-align: center;
        }

        .header-left {
            flex-direction: column;
            gap: 10px;
        }

        .dashboard-header h2 {
            font-size: 1.5rem;
        }

        .header-icon {
            font-size: 2.5rem;
        }

        .stat-badge {
            padding: 12px 20px;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        .modern-card-header h5 {
            font-size: 1.1rem;
        }

        .modern-table thead th {
            padding: 12px 8px;
            font-size: 0.8rem;
        }

        .modern-table tbody td {
            padding: 12px 8px;
            font-size: 0.85rem;
        }

        .date-badge, .duration-badge {
            padding: 6px 12px;
            font-size: 0.8rem;
        }

        .time-badge {
            padding: 5px 10px;
            font-size: 0.75rem;
        }

        .work-name {
            font-size: 0.95rem;
        }
    }

    @@media (max-width: 576px) {
        .dashboard-header {
            padding: 15px;
            border-radius: 15px;
        }

        .dashboard-header h2 {
            font-size: 1.3rem;
        }

        .header-subtitle {
            font-size: 0.85rem;
        }

        .header-icon {
            font-size: 2rem;
        }

        .stat-badge {
            padding: 10px 15px;
        }

        .stat-number {
            font-size: 1.3rem;
        }

        .stat-label {
            font-size: 0.75rem;
        }

        .modern-card {
            border-radius: 15px;
        }

        .modern-card-header {
            padding: 15px 20px;
        }

        .modern-card-header h5 {
            font-size: 1rem;
        }

        .modern-card .card-body {
            padding: 20px 15px;
        }

        .modern-table thead th {
            padding: 10px 6px;
            font-size: 0.7rem;
        }

        .modern-table tbody td {
            padding: 10px 6px;
            font-size: 0.8rem;
        }

        .btn-delete {
            padding: 6px 12px;
            font-size: 0.85rem;
        }

        .empty-state {
            padding: 40px 15px;
        }

        .empty-icon {
            font-size: 3.5rem;
        }

        .empty-state h4 {
            font-size: 1.2rem;
        }

        .empty-state p {
            font-size: 0.9rem;
        }
    }
</style>
