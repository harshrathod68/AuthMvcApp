@{
    ViewData["Title"] = "Daily Tasks";
    var skill = ViewBag.Skill as MyApps.Models.SkillMasteryModel;
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var progress = ViewBag.Progress as MyApps.Models.DailyProgressModel;
}

<style>
    .tasks-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .date-navigator {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        background: var(--card-bg);
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .date-btn {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s;
    }

    .date-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .current-date {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--text-primary);
    }

    .task-card {
        background: var(--card-bg);
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        border: 1px solid var(--border-color);
        margin-bottom: 30px;
    }

    .day-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
    }

    .day-number {
        font-size: 2rem;
        font-weight: bold;
        color: var(--text-primary);
    }

    .day-status {
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 600;
    }

    .status-completed {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
    }

    .status-pending {
        background: linear-gradient(135deg, #f5af19, #f12711);
        color: white;
    }

    .task-form {
        display: grid;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--text-primary);
        font-size: 1rem;
    }

    .form-control {
        padding: 12px;
        border: 2px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-primary);
        color: var(--text-primary);
        font-size: 1rem;
    }

    .btn-complete {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
        padding: 15px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-complete:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(17, 153, 142, 0.4);
    }

    .completed-info {
        background: rgba(17, 153, 142, 0.1);
        border-left: 4px solid #11998e;
        padding: 20px;
        border-radius: 8px;
    }

    .completed-info h3 {
        margin: 0 0 15px 0;
        color: var(--text-primary);
    }

    .completed-info p {
        margin: 8px 0;
        color: var(--text-secondary);
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
        margin-top: 30px;
    }

    .calendar-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        background: var(--card-bg);
        border: 2px solid var(--border-color);
    }

    .calendar-day:hover {
        transform: scale(1.05);
    }

    .calendar-day.completed {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
        border-color: #11998e;
    }

    .calendar-day.today {
        border-color: #667eea;
        border-width: 3px;
    }

    .actions-row {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-action {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        text-align: center;
        display: block;
    }

    .btn-dashboard {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .btn-back {
        background: var(--bg-secondary);
        color: var(--text-primary);
        border: 2px solid var(--border-color);
    }

    @@media (max-width: 768px) {
        .date-navigator {
            flex-direction: column;
        }

        .calendar-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>

<div class="tasks-header">
    <h1 style="margin: 0; font-size: 2.5rem;">📅 @skill.SkillName - Daily Tasks</h1>
    <p style="margin: 10px 0 0 0; opacity: 0.9;">Track your daily progress and stay consistent</p>
</div>

<div class="date-navigator">
    <a href="@Url.Action("Tasks", new { id = skill.Id, date = selectedDate.AddDays(-1).ToString("yyyy-MM-dd") })" class="date-btn">
        ← Previous Day
    </a>
    <div class="current-date">
        @selectedDate.ToString("MMMM dd, yyyy")
    </div>
    @if (selectedDate < DateTime.Today)
    {
        <a href="@Url.Action("Tasks", new { id = skill.Id, date = selectedDate.AddDays(1).ToString("yyyy-MM-dd") })" class="date-btn">
            Next Day →
        </a>
    }
    else
    {
        <button class="date-btn" disabled style="opacity: 0.5; cursor: not-allowed;">
            Next Day →
        </button>
    }
</div>

<div class="task-card">
    <div class="day-info">
        <div>
            <div class="day-number">
                Day @((selectedDate - skill.StartDate).Days + 1) of @skill.TotalDays
            </div>
            <p style="color: var(--text-secondary); margin: 5px 0 0 0;">
                Goal: @skill.DailyMinutes minutes
            </p>
        </div>
        <div class="day-status @(progress?.IsCompleted == true ? "status-completed" : "status-pending")">
            @(progress?.IsCompleted == true ? "✅ Completed" : "⏳ Pending")
        </div>
    </div>

    @if (progress != null && progress.IsCompleted)
    {
        <div class="completed-info">
            <h3>✅ Great job! You completed this day!</h3>
            <p><strong>Time Spent:</strong> @progress.MinutesSpent minutes</p>
            @if (!string.IsNullOrEmpty(progress.Notes))
            {
                <p><strong>Notes:</strong> @progress.Notes</p>
            }
            @if (progress.CompletedAt.HasValue)
            {
                <p><strong>Completed At:</strong> @progress.CompletedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</p>
            }
        </div>
    }
    else if (selectedDate.Date <= DateTime.Today)
    {
        <form id="completeForm" class="task-form">
            <div class="form-group">
                <label class="form-label">Time Spent (minutes) *</label>
                <input type="number" id="minutesSpent" class="form-control" min="1" max="480" value="@skill.DailyMinutes" required />
            </div>
            <div class="form-group">
                <label class="form-label">What did you learn today?</label>
                <textarea id="notes" class="form-control" rows="4" placeholder="Share your learning highlights..."></textarea>
            </div>
            <button type="submit" class="btn-complete">
                ✅ Mark as Complete
            </button>
        </form>
    }
    else
    {
        <div style="text-align: center; padding: 40px; color: var(--text-secondary);">
            <p style="font-size: 1.2rem;">📅 This day is in the future</p>
            <p>Come back on @selectedDate.ToString("MMMM dd") to complete this task!</p>
        </div>
    }
</div>

<div class="actions-row">
    <a href="@Url.Action("Dashboard", new { id = skill.Id })" class="btn-action btn-dashboard">
        📊 Back to Dashboard
    </a>
    <a href="@Url.Action("Index")" class="btn-action btn-back">
        ← All Skills
    </a>
</div>

@section Scripts {
    <script>
        document.getElementById('completeForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const minutesSpent = document.getElementById('minutesSpent').value;
            const notes = document.getElementById('notes').value;
            const btn = e.target.querySelector('button[type="submit"]');
            
            btn.disabled = true;
            btn.textContent = '⏳ Saving...';
            
            try {
                const response = await fetch('@Url.Action("MarkComplete")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `skillId=@skill.Id&date=@selectedDate.ToString("yyyy-MM-dd")&minutesSpent=${minutesSpent}&notes=${encodeURIComponent(notes)}`
                });
                
                const result = await response.json();
                
                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert('Failed to mark complete. Please try again.');
                    btn.disabled = false;
                    btn.textContent = '✅ Mark as Complete';
                }
            } catch (error) {
                alert('An error occurred. Please try again.');
                btn.disabled = false;
                btn.textContent = '✅ Mark as Complete';
            }
        });
    </script>
}
