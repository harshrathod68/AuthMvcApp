@{
    ViewData["Title"] = "Account Role Management";
}

<div class="dashboard-container">
    <div class="card">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <h4>👥 Account Role Management</h4>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">
                Configure which applications are visible for each user role. Select a role below to manage its app permissions.
            </p>

            <div class="row g-4">
                <!-- Admin Role Card -->
                <div class="col-md-6 col-lg-4">
                    <div class="role-card admin-card">
                        <div class="role-icon">👑</div>
                        <h3 class="role-title">Admin</h3>
                        <p class="role-desc">Full system access with all administrative privileges</p>
                        <a asp-action="Edit" asp-route-role="Admin" class="btn btn-primary btn-lg w-100">
                            ⚙️ Manage Apps
                        </a>
                    </div>
                </div>

                <!-- Manager Role Card -->
                <div class="col-md-6 col-lg-4">
                    <div class="role-card manager-card">
                        <div class="role-icon">💼</div>
                        <h3 class="role-title">Manager</h3>
                        <p class="role-desc">Extended access for team management and productivity tools</p>
                        <a asp-action="Edit" asp-route-role="Manager" class="btn btn-info btn-lg w-100">
                            ⚙️ Manage Apps
                        </a>
                    </div>
                </div>

                <!-- User Role Card -->
                <div class="col-md-6 col-lg-4">
                    <div class="role-card user-card">
                        <div class="role-icon">👤</div>
                        <h3 class="role-title">User</h3>
                        <p class="role-desc">Standard user access with essential applications</p>
                        <a asp-action="Edit" asp-route-role="User" class="btn btn-success btn-lg w-100">
                            ⚙️ Manage Apps
                        </a>
                    </div>
                </div>

                <!-- Moderator Role Card -->
                <div class="col-md-6 col-lg-4">
                    <div class="role-card moderator-card">
                        <div class="role-icon">🛡️</div>
                        <h3 class="role-title">Moderator</h3>
                        <p class="role-desc">Content moderation with selected app permissions</p>
                        <a asp-action="Edit" asp-route-role="Moderator" class="btn btn-warning btn-lg w-100">
                            ⚙️ Manage Apps
                        </a>
                    </div>
                </div>

                <!-- Guest Role Card -->
                <div class="col-md-6 col-lg-4">
                    <div class="role-card guest-card">
                        <div class="role-icon">🎫</div>
                        <h3 class="role-title">Guest</h3>
                        <p class="role-desc">Limited access for temporary or trial users</p>
                        <a asp-action="Edit" asp-route-role="Guest" class="btn btn-secondary btn-lg w-100">
                            ⚙️ Manage Apps
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .role-card {
        background: var(--card-bg);
        border: 2px solid var(--border-color);
        border-radius: 20px;
        padding: 40px 30px;
        text-align: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px var(--shadow-light);
    }

    .role-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 30px var(--shadow-medium);
    }

    .admin-card {
        border-color: #667eea;
    }

    .admin-card:hover {
        border-color: #764ba2;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
    }

    .manager-card {
        border-color: #17a2b8;
    }

    .manager-card:hover {
        border-color: #138496;
        background: linear-gradient(135deg, rgba(23, 162, 184, 0.05) 0%, rgba(19, 132, 150, 0.05) 100%);
    }

    .user-card {
        border-color: #11998e;
    }

    .user-card:hover {
        border-color: #38ef7d;
        background: linear-gradient(135deg, rgba(17, 153, 142, 0.05) 0%, rgba(56, 239, 125, 0.05) 100%);
    }

    .moderator-card {
        border-color: #ffc107;
    }

    .moderator-card:hover {
        border-color: #ff9800;
        background: linear-gradient(135deg, rgba(255, 193, 7, 0.05) 0%, rgba(255, 152, 0, 0.05) 100%);
    }

    .guest-card {
        border-color: #6c757d;
    }

    .guest-card:hover {
        border-color: #495057;
        background: linear-gradient(135deg, rgba(108, 117, 125, 0.05) 0%, rgba(73, 80, 87, 0.05) 100%);
    }

    .role-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .role-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 15px;
    }

    .role-desc {
        color: var(--text-secondary);
        font-size: 1rem;
        margin-bottom: 25px;
        min-height: 50px;
    }

    @@media (max-width: 767px) {
        .role-card {
            padding: 30px 20px;
        }

        .role-icon {
            font-size: 3rem;
        }

        .role-title {
            font-size: 1.5rem;
        }

        .role-desc {
            font-size: 0.9rem;
        }
    }
</style>
