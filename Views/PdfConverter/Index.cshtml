@model MyApps.Models.PdfConversionModel
@{
    ViewData["Title"] = "PDF Converter";
}

<div class="dashboard-container">
    <div class="pdf-header">
        <div>
            <h2>📄 PDF Converter</h2>
            <p class="text-muted">Convert any content to PDF format</p>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h5 class="mb-0">📄 Convert to PDF</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <strong>💡 Tip:</strong> आप Text, Images, या दोनों को एक साथ PDF में convert कर सकते हैं!<br/>
                        <small>You can convert text, images, or both together into a single PDF document.</small>
                    </div>

                    <form asp-action="ConvertMixed" method="post" enctype="multipart/form-data" id="pdfForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Document Title</label>
                            <input type="text" name="Title" class="form-control" placeholder="My Document" required />
                        </div>

                        <!-- Text Content Section -->
                        <div class="mb-4">
                            <label class="form-label">✏️ Text Content (Optional)</label>
                            <textarea name="Content" class="form-control" rows="6" 
                                      placeholder="Enter your text content here..."></textarea>
                            <small class="text-muted">Add text content to your PDF document</small>
                        </div>

                        <!-- Image Upload Section -->
                        <div class="mb-4">
                            <label class="form-label">🖼️ Upload Images (Optional)</label>
                            <input type="file" name="Images" class="form-control" accept="image/*" multiple id="imageInput" />
                            <small class="text-muted">
                                Supported formats: JPG, PNG, GIF, BMP - You can select multiple images
                            </small>
                            <div id="imagePreview" class="image-preview-container mt-3"></div>
                        </div>

                        <!-- Advanced Options -->
                        <div class="advanced-options">
                            <button type="button" class="btn btn-sm btn-outline-secondary mb-3" 
                                    data-bs-toggle="collapse" data-bs-target="#advancedOptions">
                                ⚙️ Advanced Options
                            </button>

                            <div class="collapse" id="advancedOptions">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Page Size</label>
                                        <select name="PageSize" class="form-select">
                                            <option value="A4">A4</option>
                                            <option value="Letter">Letter</option>
                                            <option value="Legal">Legal</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Font Size</label>
                                        <input name="FontSize" type="number" class="form-control" min="8" max="24" value="12" />
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Image Fit</label>
                                        <select name="ImageFit" class="form-select">
                                            <option value="FitPage">Fit to Page</option>
                                            <option value="FitWidth">Fit Width</option>
                                            <option value="Original">Original Size</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Author Name</label>
                                    <input name="Author" class="form-control" placeholder="Your Name" />
                                </div>

                                <div class="row">
                                    <div class="col-md-3 mb-3">
                                        <div class="form-check">
                                            <input name="IncludeHeader" type="checkbox" class="form-check-input" id="includeHeader" checked />
                                            <label class="form-check-label" for="includeHeader">Include Header</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="form-check">
                                            <input name="IncludeFooter" type="checkbox" class="form-check-input" id="includeFooter" checked />
                                            <label class="form-check-label" for="includeFooter">Include Footer</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="form-check">
                                            <input name="IncludePageNumbers" type="checkbox" class="form-check-input" id="includePageNumbers" checked />
                                            <label class="form-check-label" for="includePageNumbers">Page Numbers</label>
                                        </div>
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="form-check">
                                            <input name="OneImagePerPage" type="checkbox" class="form-check-input" id="onePerPage" checked />
                                            <label class="form-check-label" for="onePerPage">One Image/Page</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                📄 Generate PDF
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pdf-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .pdf-header h2 {
        margin: 0;
        color: var(--text-primary);
    }

    .advanced-options {
        background: var(--bg-secondary);
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .image-preview-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
        max-height: 300px;
        overflow-y: auto;
        padding: 10px;
        background: var(--bg-secondary);
        border-radius: 8px;
    }

    .image-preview-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid var(--border-color);
    }

    .image-preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-preview-item .image-name {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 5px;
        font-size: 0.7rem;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<script>
    document.getElementById('imageInput')?.addEventListener('change', function(e) {
        const preview = document.getElementById('imagePreview');
        preview.innerHTML = '';
        
        const files = e.target.files;
        if (files.length > 0) {
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                
                reader.onload = function(event) {
                    const div = document.createElement('div');
                    div.className = 'image-preview-item';
                    div.innerHTML = `
                        <img src="${event.target.result}" alt="${file.name}">
                        <div class="image-name">${file.name}</div>
                    `;
                    preview.appendChild(div);
                };
                
                reader.readAsDataURL(file);
            }
        }
    });

    // Form validation
    document.getElementById('pdfForm')?.addEventListener('submit', function(e) {
        const content = document.querySelector('textarea[name="Content"]').value.trim();
        const images = document.getElementById('imageInput').files;
        
        if (!content && images.length === 0) {
            e.preventDefault();
            alert('कृपया कम से कम Text या Images में से एक प्रदान करें!\n\nPlease provide either text content or images!');
            return false;
        }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
