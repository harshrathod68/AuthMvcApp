@model AuthMvcApp.Models.EditUserModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="form-container" style="max-width: 550px;">
    <div class="card">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);">
            <h4>✏️ Edit User</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full Name *</label>
                    <div class="input-group">
                        <span class="input-group-text edit-icon">👤</span>
                        <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address *</label>
                    <div class="input-group">
                        <span class="input-group-text edit-icon">📧</span>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text edit-icon">🔒</span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current" id="password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password', this)">👁️</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <small class="text-muted">Leave blank to keep the current password</small>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text edit-icon">🔒</span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" id="confirmPassword" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', this)">👁️</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="City" class="form-label">City</label>
                    <div class="input-group">
                        <span class="input-group-text edit-icon">🏙️</span>
                        <input asp-for="City" class="form-control" placeholder="Enter city" />
                    </div>
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning btn-lg text-white">
                        💾 Update User
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        ← Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .edit-icon {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%) !important;
        border: none;
        color: white;
        font-size: 1.1rem;
        padding: 12px 15px;
    }

    .input-group .form-control {
        border-left: none;
    }

    .input-group .form-control:focus {
        border-color: #f5af19;
    }

    .input-group .btn-outline-secondary {
        border-color: #e8e8e8;
        background: #f8f9fa;
    }

    .btn-warning {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
        border: none;
    }

    .btn-warning:hover {
        background: linear-gradient(135deg, #e09f15 0%, #d9220f 100%);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.innerHTML = "🙈";
            } else {
                input.type = "password";
                btn.innerHTML = "👁️";
            }
        }
    </script>
}
