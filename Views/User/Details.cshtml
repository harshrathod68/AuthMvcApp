@model AuthMvcApp.Models.UserDataModel
@{
    ViewData["Title"] = "User Details";
}

<div class="form-container" style="max-width: 550px;">
    <div class="card">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <h4>👤 User Details</h4>
        </div>
        <div class="card-body">
            <!-- User Avatar -->
            <div class="text-center mb-4">
                <div class="detail-avatar">
                    @Model.Name[0].ToString().ToUpper()
                </div>
                <h4 class="mt-3 mb-1">@Model.Name</h4>
                <p class="text-muted">@Model.Email</p>
            </div>

            <!-- User Info -->
            <div class="user-info-card">
                <div class="info-row">
                    <span class="info-icon">🆔</span>
                    <div class="info-content">
                        <span class="info-label">User ID</span>
                        <span class="info-value">#@Model.Id</span>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-icon">👤</span>
                    <div class="info-content">
                        <span class="info-label">Full Name</span>
                        <span class="info-value">@Model.Name</span>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-icon">📧</span>
                    <div class="info-content">
                        <span class="info-label">Email Address</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-icon">🏙️</span>
                    <div class="info-content">
                        <span class="info-label">City</span>
                        <span class="info-value">@(Model.City ?? "Not provided")</span>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-icon">📅</span>
                    <div class="info-content">
                        <span class="info-label">Created At</span>
                        <span class="info-value">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</span>
                    </div>
                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="info-row">
                        <span class="info-icon">🔄</span>
                        <div class="info-content">
                            <span class="info-label">Last Updated</span>
                            <span class="info-value">@Model.UpdatedAt.Value.ToString("MMMM dd, yyyy hh:mm tt")</span>
                        </div>
                    </div>
                }

                <div class="info-row">
                    <span class="info-icon">✅</span>
                    <div class="info-content">
                        <span class="info-label">Login Status</span>
                        <span class="info-value">
                            <span class="badge bg-success">Can Login</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg text-white">
                    ✏️ Edit User
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    ← Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-avatar {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0 auto;
        box-shadow: 0 10px 30px rgba(79, 172, 254, 0.3);
    }

    .user-info-card {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 5px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: white;
        margin: 5px;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .info-row:hover {
        transform: translateX(5px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }

    .info-icon {
        font-size: 1.5rem;
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        display: block;
        font-size: 0.8rem;
        color: #888;
        margin-bottom: 3px;
    }

    .info-value {
        display: block;
        font-weight: 600;
        color: #333;
    }

    .btn-warning {
        background: linear-gradient(135deg, #f5af19 0%, #f12711 100%);
        border: none;
    }
</style>
