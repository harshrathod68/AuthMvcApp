@model MyApps.Models.UserOtpVerificationModel
@{
    ViewData["Title"] = "Verify OTP";
}

<div class="verify-otp-container">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card otp-card">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="otp-icon">📧</div>
                        <h4 class="fw-bold">Verify Email</h4>
                        <p class="text-muted">Enter the 6-digit OTP sent to</p>
                        <p class="email-display">@Model.Email</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="VerifyOtp" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-4">
                            <label asp-for="Otp" class="form-label">Enter OTP</label>
                            <input asp-for="Otp" class="form-control form-control-lg text-center otp-input" 
                                   placeholder="000000" maxlength="6" autocomplete="off" />
                            <span asp-validation-for="Otp" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                            <i class="bi bi-check-circle me-2"></i>Verify OTP
                        </button>
                    </form>

                    <form asp-action="ResendOtp" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <p class="text-muted mb-2">Didn't receive the code?</p>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-clockwise me-1"></i>Resend OTP
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="Create" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Back to Add User
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .verify-otp-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .otp-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .otp-icon {
        font-size: 4rem;
        margin-bottom: 15px;
    }

    .email-display {
        color: #667eea;
        font-weight: 600;
        font-size: 1rem;
    }

    .otp-input {
        font-size: 1.8rem;
        letter-spacing: 10px;
        font-weight: 700;
        border-radius: 12px;
        border: 2px solid #e0e0e0;
        padding: 15px;
    }

    .otp-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
        transform: translateY(-2px);
    }

    .btn-outline-secondary {
        border-radius: 8px;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Auto-focus on OTP input
        document.querySelector('.otp-input').focus();
        
        // Only allow numbers in OTP field
        document.querySelector('.otp-input').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
}
