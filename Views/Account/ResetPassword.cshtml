@model MyApps.Models.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="form-container">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h4>🔑 Reset Password</h4>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="text-center mb-4">
                <span style="font-size: 3rem;">📧</span>
                <p class="mt-2 mb-0">Reset Code sent to</p>
                <p class="text-gradient" style="font-weight: 700; font-size: 1.1rem;">@Model.Email</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Otp" class="form-label">Enter 6-digit Reset Code</label>
                    <input asp-for="Otp" class="form-control text-center" 
                           maxlength="6" placeholder="000000" 
                           style="letter-spacing: 12px; font-size: 1.5rem; font-weight: 700;" />
                    <span asp-validation-for="Otp" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <div class="input-group">
                        <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" id="newPassword" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('newPassword', this)">👁️</button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" id="confirmPassword" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', this)">👁️</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                
                <div class="d-grid">
                    <button type="submit" class="btn btn-info btn-lg text-white">Reset Password</button>
                </div>
            </form>
            
            <hr />
            <div class="text-center">
                <p class="text-muted mb-2">Didn't receive Reset Code?</p>
                <form asp-action="ResendResetOtp" method="post">
                    <button type="submit" class="btn btn-outline-secondary">Resend Reset Code</button>
                </form>
            </div>

            <div class="alert alert-warning mt-3 text-center">
                <small>⏱️ Reset Code valid for 5 minutes</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('Otp').addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });

        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.innerHTML = "🙈";
            } else {
                input.type = "password";
                btn.innerHTML = "👁️";
            }
        }
    </script>
}
