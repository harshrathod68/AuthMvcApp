@model MyApps.Models.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="form-container">
    <div class="card">
        <div class="card-header bg-warning text-white">
            <h4>🔒 Forgot Password</h4>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="text-center mb-4">
                <span style="font-size: 3.5rem;">🔐</span>
                <p class="mt-3 text-muted">Enter your email address and we'll send you a Reset Code to reset your password.</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your registered email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning btn-lg">Send Reset Code</button>
                    <a asp-action="Login" class="btn btn-secondary">← Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
