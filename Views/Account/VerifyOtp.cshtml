@model AuthMvcApp.Models.OtpVerificationModel

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="form-container">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h4>🔐 OTP Verification</h4>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="text-center mb-4">
                <span style="font-size: 4rem;">📧</span>
                <p class="mt-3 mb-0">OTP sent to</p>
                <p class="text-gradient" style="font-weight: 700; font-size: 1.1rem;">@Model.Email</p>
            </div>

            <form asp-action="VerifyOtp" method="post">
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <div class="mb-4">
                    <label asp-for="Otp" class="form-label text-center d-block">Enter 6-digit OTP</label>
                    <input asp-for="Otp" class="form-control text-center" 
                           maxlength="6" placeholder="000000" 
                           style="letter-spacing: 15px; font-size: 1.8rem; font-weight: 700; padding: 18px;" />
                    <span asp-validation-for="Otp" class="text-danger"></span>
                </div>
                
                <div class="d-grid">
                    <button type="submit" class="btn btn-info btn-lg text-white">Verify OTP</button>
                </div>
            </form>
            
            <hr />
            <div class="text-center">
                <p class="text-muted mb-2">Didn't receive OTP?</p>
                <form asp-action="ResendOtp" method="post">
                    <button type="submit" class="btn btn-outline-secondary">Resend OTP</button>
                </form>
            </div>

            <div class="alert alert-warning mt-4 text-center">
                <small>⏱️ OTP valid for 5 minutes</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('Otp').addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
}
