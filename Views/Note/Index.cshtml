@model List<MyApps.Models.NoteModel>
@{
    ViewData["Title"] = "My Notes";
    var currentCategory = ViewBag.CurrentCategory as string;
    var search = ViewBag.Search as string;
}

<div class="notes-container">
    <!-- Header -->
    <div class="notes-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h3 class="fw-bold"><span class="me-2">📝</span>My Notes</h3>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" class="btn btn-add-note">
                    <i class="bi bi-plus-lg me-1"></i>Add Note
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Only -->
    <div class="card filter-card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control uniform-input" placeholder="Search notes..." value="@search" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary uniform-input w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notes Grid -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var note in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card note-card" style="border-top: 4px solid @note.Color;">
                        <div class="card-body">
                            <div class="note-header">
                                <span class="note-category">
                                    @(note.Category == "text" ? "📝" : 
                                      note.Category == "image" ? "🖼️" : 
                                      note.Category == "link" ? "🔗" : 
                                      note.Category == "todo" ? "✅" : "💡")
                                </span>
                                @if (note.IsPinned)
                                {
                                    <span class="pin-badge">📌 Pinned</span>
                                }
                            </div>
                            
                            <h5 class="note-title">@note.Title</h5>
                            
                            @if (note.Category == "image" && !string.IsNullOrEmpty(note.ImageUrl))
                            {
                                <img src="@note.ImageUrl" class="note-image" alt="Note Image" />
                            }
                            
                            @if (note.Category == "link" && !string.IsNullOrEmpty(note.LinkUrl))
                            {
                                <a href="@note.LinkUrl" target="_blank" class="note-link">
                                    🔗 @note.LinkUrl
                                </a>
                            }
                            
                            @if (note.Category == "todo" && note.TodoItems != null)
                            {
                                <ul class="todo-list">
                                    @foreach (var item in note.TodoItems.Take(3))
                                    {
                                        <li class="@(item.IsCompleted ? "completed" : "")">
                                            @(item.IsCompleted ? "✅" : "⬜") @item.Text
                                        </li>
                                    }
                                    @if (note.TodoItems.Count > 3)
                                    {
                                        <li class="more">+@(note.TodoItems.Count - 3) more...</li>
                                    }
                                </ul>
                            }
                            else if (!string.IsNullOrEmpty(note.Content))
                            {
                                <p class="note-content">
                                    @(note.Content.Length > 100 ? note.Content.Substring(0, 100) + "..." : note.Content)
                                </p>
                            }
                            
                            <div class="note-footer">
                                <small class="text-muted">@note.CreatedAt.ToString("MMM dd, yyyy")</small>
                                <div class="note-actions">
                                    <form asp-action="TogglePin" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@note.Id" />
                                        <button type="submit" class="btn btn-sm btn-icon" title="@(note.IsPinned ? "Unpin" : "Pin")">
                                            @(note.IsPinned ? "📌" : "📍")
                                        </button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-icon" title="Edit">✏️</a>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this note?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@note.Id" />
                                        <button type="submit" class="btn btn-sm btn-icon" title="Delete">🗑️</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <span style="font-size: 5rem;">📝</span>
            <h4 class="mt-3">No notes yet</h4>
            <p class="text-muted">Create your first note!</p>
            <a asp-action="Create" class="btn btn-add-note">Add Note</a>
        </div>
    }
</div>

<!-- Back Button at Bottom -->
<div class="text-center mt-4 mb-4">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-back">
        <i class="bi bi-arrow-left me-2"></i>← Back to Dashboard
    </a>
</div>

<style>
    .notes-container { padding: 20px; }
    
    .btn-add-note {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 25px;
        padding: 10px 25px;
        font-weight: 600;
    }
    .btn-add-note:hover { color: white; transform: translateY(-2px); }
    
    .filter-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }
    
    [data-theme="dark"] .filter-card {
        background: #2d2d2d;
        color: #ffffff;
    }
    
    /* Uniform input sizes */
    .uniform-input {
        height: 42px !important;
        font-size: 0.9rem;
        padding: 8px 12px;
    }
    
    .uniform-input.btn {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }
    
    .note-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
    }
    
    [data-theme="dark"] .note-card {
        background: #2d2d2d;
        color: #ffffff;
    }
    
    .note-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }
    
    .note-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
    .note-category { font-size: 1.5rem; }
    .pin-badge {
        background: #ffeaa7;
        padding: 3px 10px;
        border-radius: 10px;
        font-size: 0.75rem;
    }
    
    .note-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 10px; color: inherit; }
    .note-content { color: var(--text-secondary); font-size: 0.9rem; }
    
    .note-image {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 10px;
    }
    
    .note-link {
        display: block;
        background: var(--bg-secondary);
        padding: 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        color: #4facfe;
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .todo-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .todo-list li {
        padding: 5px 0;
        font-size: 0.9rem;
    }
    .todo-list li.completed { text-decoration: line-through; color: var(--text-muted); }
    .todo-list li.more { color: #667eea; font-style: italic; }
    
    .note-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 10px;
        border-top: 1px solid var(--border-color);
        color: inherit;
    }
    
    .btn-icon {
        background: none;
        border: none;
        font-size: 1.1rem;
        padding: 5px;
    }
    .btn-icon:hover { transform: scale(1.2); }
</style>
